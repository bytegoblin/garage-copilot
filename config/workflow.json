{
  "max_retries": 3,
  "default_tone": "restrained",
  "language": {
    "user_facing": "ru",
    "repository": "en"
  },
  "run_id_pattern": "^[0-9]{8}-[0-9]{4}-[a-z0-9-]+$",
  "research_depth": {
    "quick": {
      "max_searches": 6,
      "max_fetches": 8
    },
    "standard": {
      "max_searches": 12,
      "max_fetches": 15
    },
    "retry": {
      "max_searches": 4,
      "max_fetches": 5
    }
  },
  "validator_depth": {
    "first_pass_spot_checks": 5,
    "revalidation_spot_checks": 2
  },
  "artifact_max_chars": {
    "research": 10000,
    "products": 9000,
    "project-plan": 14000,
    "budget": 10000,
    "validation": 9000,
    "final-plan": 18000
  },
  "artifact_hard_factor": 1.15,
  "source_policy": {
    "local_tlds": [
      "pl"
    ],
    "eu_tlds": [
      "eu",
      "at",
      "be",
      "bg",
      "hr",
      "cy",
      "cz",
      "dk",
      "ee",
      "fi",
      "fr",
      "de",
      "gr",
      "hu",
      "ie",
      "it",
      "lv",
      "lt",
      "lu",
      "mt",
      "nl",
      "pt",
      "ro",
      "sk",
      "si",
      "es",
      "se"
    ],
    "ambiguous_locale_codes": [
      "en",
      "int",
      "global",
      "www"
    ],
    "pdf": {
      "allowed": true,
      "require_page_reference": true,
      "max_documents_per_node": 2
    }
  },
  "node_models": {
    "product-researcher-ppe": "haiku"
  },
  "playbooks": {
    "tiling": "trade-tiling",
    "carpentry": "trade-carpentry"
  },
  "price_coverage": {
    "max_unpriced_share": 0.3
  },
  "product_nodes": {
    "max_positions_per_node": 6
  }
